{
  "name": "openairtwin-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=10"
  },
  "scripts": {
    "build": "vite build && npm run verify:build",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run format:check",
    "dev": "node scripts/dev.mjs",
    "dev:catalog": "vite",
    "dev:ui": "vite",
    "format": "prettier --write . ../tools/ui-catalog/index.html ../tools/ui-catalog/catalog.css ../tests/browser/ui_catalog.spec.js",
    "format:check": "prettier --check . ../tools/ui-catalog/index.html ../tools/ui-catalog/catalog.css ../tests/browser/ui_catalog.spec.js",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"../backend/static/css/*.css\" \"../tools/ui-catalog/catalog.css\" --max-warnings 0",
    "test": "npm run check && npm run test:unit && npm run build",
    "test:e2e": "npm run build && npm --prefix ../tests/browser test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
