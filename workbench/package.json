{
  "name": "openairtwin-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=10"
  },
  "scripts": {
    "build": "vite build && npm run verify:build",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run format:check",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"../backend/static/css/*.css\" --max-warnings 0",
    "test": "npm run check && npm run build",
    "test:e2e": "npm run build && npm --prefix ../tests/browser test",
    "typecheck": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  }
}
